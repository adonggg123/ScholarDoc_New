{
  "version": 2,
  "functions": {
    "api/**": {
      "includeFiles": "{student_web,admin_web,superadmin_web,assets,scratch}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/[...path]" },
    { "source": "/", "destination": "/student_web/landing.html" },
    { "source": "/landing", "destination": "/student_web/landing.html" },
    { "source": "/landing.html", "destination": "/student_web/landing.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/student", "destination": "/student_web/dashboard.html" },
    { "source": "/dashboard", "destination": "/student_web/dashboard.html" },
    { "source": "/admin", "destination": "/admin_web/admin.html" },
    { "source": "/superadmin", "destination": "/superadmin_web/superadmin.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
