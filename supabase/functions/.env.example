# ==============================================================================
# ScholarDoc Supabase Edge Function Environment Secrets
# ==============================================================================
# Set these secrets in Supabase CLI or in your Supabase Dashboard:
# Project Dashboard -> Project Settings -> Edge Functions -> Secrets
#
# Using CLI:
# npx supabase secrets set RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# npx supabase secrets set SENDER_EMAIL="ScholarDoc <onboarding@resend.dev>"
# npx supabase secrets set APP_DOWNLOAD_URL="https://scholardoc.app/download"
# ==============================================================================

# 1. Resend API Key (Get this from https://resend.com/api-keys)
# Sign up for free at https://resend.com — Free tier: 100 emails/day, 3000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Sender Email Address
# For testing, use the default Resend test address: "ScholarDoc <onboarding@resend.dev>"
# For production, verify your domain at https://resend.com/domains and use your own address
SENDER_EMAIL=ScholarDoc <onboarding@resend.dev>

# 3. Mobile App Download URL (Where students can download the ScholarDoc Android APK or iOS app)
APP_DOWNLOAD_URL=https://scholardoc.app/download

# 4. Supabase Credentials (Automatically populated by Supabase when deployed)
# SUPABASE_URL=https://ywavesulvkqwpsejprxp.supabase.co
# SUPABASE_ANON_KEY=<auto-populated>
# SUPABASE_SERVICE_ROLE_KEY=<auto-populated>
